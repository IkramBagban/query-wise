{
  "name": "query-wise-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently --names web,worker \"pnpm --filter @query-wise/web dev\" \"pnpm --filter @query-wise/worker dev\"",
    "build": "pnpm --filter @query-wise/web build && pnpm --filter @query-wise/worker build",
    "db:generate": "pnpm --filter @query-wise/shared db:generate",
    "db:migrate:dev": "pnpm --filter @query-wise/shared db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @query-wise/shared db:migrate:deploy"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  },
  "dependencies": {
    "ioredis": "^5.11.1",
    "pnpm": "^11.9.0",
    "react-resizable": "^4.0.2"
  }
}
