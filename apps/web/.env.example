# =============================================================================
# QueryWise Web — Environment Variables Reference
# =============================================================================
# Copy this file to .env.local for local development.
# All values below reflect what is configured on Vercel (query-wise-web-prod).
# =============================================================================

# -----------------------------------------------------------------------------
# 🔴 REQUIRED — Database
# -----------------------------------------------------------------------------

# Primary app database (Neon PostgreSQL)
QUERYWISE_APP_DATABASE_URL=postgresql://neondb_owner:npg_S5DxZ4RFeodj@ep-dark-resonance-at8vntzw-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Alias used by Prisma CLI and some legacy code paths
DATABASE_URL=postgresql://neondb_owner:npg_S5DxZ4RFeodj@ep-dark-resonance-at8vntzw-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# -----------------------------------------------------------------------------
# 🔴 REQUIRED — Clerk Authentication
# -----------------------------------------------------------------------------

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_bmVhcmJ5LWNyYWItNzkuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_j3QUxbRidXSaNkAyDN970O9YlDMlbAnbnt9CmjtKLr
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# -----------------------------------------------------------------------------
# 🔴 REQUIRED — Security / Encryption Keys
# -----------------------------------------------------------------------------

# 32-byte base64 key used to encrypt/decrypt user database credentials
QUERYWISE_CREDENTIAL_ENCRYPTION_KEY_V1=IR6dBl2ydVtr3KTHVnoHPiE3suWRB7BF0EkYEPU8DyY=

# Used to sign pagination cursors (falls back to CLERK_SECRET_KEY if omitted)
QUERYWISE_CURSOR_SIGNING_KEY=IR6dBl2ydVtr3KTHVnoHPiE3suWRB7BF0EkYEPU8DyY=

# Used to sign shared dashboard unlock tokens (falls back to CLERK_SECRET_KEY if omitted)
QUERYWISE_SHARE_UNLOCK_SIGNING_KEY=mUYWjHaBoMjao0N/UeHt8UB/m7dSAGt3ecboeGTXWpk=

# -----------------------------------------------------------------------------
# 🔴 REQUIRED — LLM / AI Provider (at least one required)
# -----------------------------------------------------------------------------

GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyDf4dMc-k2OMHVUriVC9AhVdivFtNtduCw

# Uncomment if using Groq
# GROQ_API_KEY=

# Uncomment if using Anthropic
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# 🟡 HIGHLY RECOMMENDED — Redis (result caching, live dashboards)
# -----------------------------------------------------------------------------

QUERYWISE_REDIS_URL=redis://default:1zIAAovgsOgqZXswnqyeZpFaSw3lu1HE@redis-19880.c322.us-east-1-2.ec2.cloud.redislabs.com:19880
# REDIS_URL=  # fallback alias

# -----------------------------------------------------------------------------
# 🟡 HIGHLY RECOMMENDED — App URL (required for share link generation)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=https://query-wise-web-prod.vercel.app

# -----------------------------------------------------------------------------
# 🟢 OPTIONAL — Schema Ingestion LLM
# -----------------------------------------------------------------------------

QUERYWISE_INGESTION_LLM_PROVIDER=google
QUERYWISE_INGESTION_LLM_MODEL=gemini-3.1-flash-lite
# Comma-separated list of API keys for ingestion (round-robins between them)
QUERYWISE_INGESTION_LLM_API_KEY=AIzaSyDf4dMc-k2OMHVUriVC9AhVdivFtNtduCw,AIzaSyBXtFNBjlI1nY6LFXetQzMAfE7d_RqbtSQ

# Whether to include sample DB rows in schema context sent to LLM
QUERYWISE_LLM_INCLUDE_SAMPLE_ROWS=false

# -----------------------------------------------------------------------------
# 🟢 OPTIONAL — LLM Query Generation Overrides
# -----------------------------------------------------------------------------

# Override the primary text-to-SQL LLM provider/model
# QUERYWISE_LLM_PROVIDER=google
# QUERYWISE_LLM_MODEL=gemini-3.1-flash-lite

# Token budget limit for LLM context windows
# QUERYWISE_MODEL_INPUT_BUDGET=

# Disable LLM SQL safety/verification pass (set to "false" to disable)
# QUERYWISE_AGENT_VERIFICATION=true

# -----------------------------------------------------------------------------
# 🟢 OPTIONAL — Embeddings (for semantic schema search)
# -----------------------------------------------------------------------------

# QUERYWISE_EMBEDDING_PROVIDER=google
# QUERYWISE_EMBEDDING_MODEL=text-embedding-004

# -----------------------------------------------------------------------------
# 🟢 OPTIONAL — Cron / Internal API Security
# -----------------------------------------------------------------------------

# Secret token for /api/internal/query-runs/recover endpoint
# CRON_SECRET=

# -----------------------------------------------------------------------------
# 🟢 OPTIONAL — Demo Mode
# -----------------------------------------------------------------------------

DEMO_SEED=20260611
DEMO_REFERENCE_DATE=2026-06-11T00:00:00.000Z
DEMO_USERNAME=demo
DEMO_PASSWORD=replace_me

# PostgreSQL URL for the pre-seeded instant demo database connection
# DEMO_DATABASE_URL=

# -----------------------------------------------------------------------------
# 🟢 OPTIONAL — Logging & Observability
# -----------------------------------------------------------------------------

# Set to "1" to force structured logging in production
# QUERYWISE_LOG_ENABLED=

# Custom directory path for writing log files
# QUERYWISE_LOG_DIR=
