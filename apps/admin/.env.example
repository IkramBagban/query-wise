# apps/admin — variable names only (never commit real values).
# Self-hosters: you are the admin of your instance. Put your own Clerk user id
# in ADMIN_CLERK_USER_IDS (comma-separated for multiple operators).
#
# App DB: The admin app relies on DATABASE_URL.
# Do not put LLM keys, encryption keys, or the demo DB URL here.

DATABASE_URL=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
ADMIN_CLERK_USER_IDS=
