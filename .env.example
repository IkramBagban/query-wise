# QueryWise application database
# Stores encrypted connection credentials, schema snapshots, conversations,
# query runs, dashboards, shares, and rate-limit state.
QUERYWISE_APP_DATABASE_URL=postgresql://user:password@host/querywise_app?sslmode=require

# Clerk user authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Generate independent random Base64 values that decode to at least 32 bytes.
# QUERYWISE_CREDENTIAL_ENCRYPTION_KEY_V1 must decode to exactly 32 bytes.
QUERYWISE_CREDENTIAL_ENCRYPTION_KEY_V1=replace_with_32_byte_base64_key
QUERYWISE_CURSOR_SIGNING_KEY=replace_with_32_byte_base64_key
QUERYWISE_SHARE_UNLOCK_SIGNING_KEY=replace_with_a_long_random_secret

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Pre-seeded ecommerce database queried by the demo experience.
# This may be the same PostgreSQL server as the application database, but a
# separate database and read-only query user are recommended for production.
DEMO_DATABASE_URL=postgresql://readonly_user:password@host/querywise_demo?sslmode=require

# Background schema ingestion worker
# Required when running `npm run worker:schema-ingestion`.
QUERYWISE_REDIS_URL=redis://localhost:6379

# Protects internal scheduled-maintenance endpoints.
# Generate a long random value and configure the scheduler to send it as:
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace_with_a_long_random_secret

# Server-side LLM key used only by background schema ingestion/enrichment.
# User-submitted query runs still use the browser-provided per-session API key.
QUERYWISE_INGESTION_LLM_PROVIDER=google
QUERYWISE_INGESTION_LLM_MODEL=gemini-2.5-flash
QUERYWISE_INGESTION_LLM_API_KEY=replace_with_server_ingestion_key

# Query prompt data controls.
# Keep raw row samples disabled unless each connection/source is approved for
# sample disclosure to the LLM provider. Column ranges/top values may still be
# used after redaction.
QUERYWISE_LLM_INCLUDE_SAMPLE_ROWS=false

# Optional deterministic demo seed configuration
DEMO_SEED=20260611
DEMO_REFERENCE_DATE=2026-06-11T00:00:00.000Z

# Legacy demo sign-in route only; Clerk protects the current application routes.
DEMO_USERNAME=demo
DEMO_PASSWORD=replace_me
