generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("QUERYWISE_APP_DATABASE_URL")
}

enum ConnectionStatus {
  pending
  connected
  error
  disabled
  deleting
  deleted

  @@map("v2_connection_status")
}

enum SchemaSyncStatus {
  never
  queued
  running
  introspecting
  describing
  embedding
  ready
  error

  @@map("v2_schema_sync_status")
}

enum SnapshotStatus {
  queued
  syncing
  succeeded
  failed
  superseded

  @@map("v2_snapshot_status")
}

enum ConversationStatus {
  active
  archived

  @@map("v2_conversation_status")
}

enum MessageRole {
  user
  assistant
  system

  @@map("v2_message_role")
}

enum QueryRunStatus {
  accepted
  preparing
  generating
  validating
  executing
  persisting
  succeeded
  failed
  cancelled
  expired

  @@map("v2_query_run_status")
}

enum JobStatus {
  queued
  running
  succeeded
  dead
  cancelled

  @@map("v2_job_status")
}

// Plan catalog id. Default free; pro is granted only by manual DB mutation (or a
// future payment webhook). No public API sets pro.
enum PlanId {
  free
  pro

  @@map("v2_plan_id")
}

// v1 ships only active | disabled. `disabled` blocks every plan-enforced mutation
// (ACCOUNT_DISABLED) while leaving reads allowed. Payment dunning states are
// reserved for a later phase.
enum PlanStatus {
  active
  disabled

  @@map("v2_plan_status")
}

// How the current plan row was assigned. A payment source is reserved for a later
// phase and intentionally omitted from the v1 enum (additive later).
enum PlanSource {
  default
  manual

  @@map("v2_plan_source")
}

model User {
  id          String    @id @db.Uuid
  clerkUserId String    @unique(map: "v2_users_clerk_user_id_key") @map("clerk_user_id")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("v2_users")
}

model DatabaseConnection {
  id                String           @id @db.Uuid
  ownerUserId       String           @map("owner_user_id")
  providerId        String           @default("postgresql") @map("provider_id")
  dialectId         String           @default("postgresql") @map("dialect_id")
  name              String
  hostDisplay       String           @map("host_display")
  port              Int?
  databaseName      String           @map("database_name")
  encryptedSecret   Json?            @map("encrypted_secret")
  credentialVersion Int              @default(1) @map("credential_version")
  status            ConnectionStatus @default(pending)
  // The platform demo connection does not consume the Free non-demo connection
  // slot. A boolean flag is authoritative; name-matching is fragile (users can
  // rename or collide). Set in createDemoConnection.
  isDemo            Boolean          @default(false) @map("is_demo")
  lastTestedAt      DateTime?        @map("last_tested_at") @db.Timestamptz(6)
  lastTestErrorCode String?          @map("last_test_error_code")
  lastSchemaSyncAt  DateTime?        @map("last_schema_sync_at") @db.Timestamptz(6)
  schemaSyncStatus  SchemaSyncStatus @default(never) @map("schema_sync_status")
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([id, ownerUserId], map: "v2_connections_id_owner_key")
  @@index([ownerUserId, updatedAt(sort: Desc), id(sort: Desc)], map: "v2_connections_owner_updated_idx")
  @@map("v2_database_connections")
}

model SchemaSnapshot {
  id              String         @id @db.Uuid
  ownerUserId     String         @map("owner_user_id")
  connectionId    String         @map("connection_id") @db.Uuid
  snapshotVersion Int            @map("snapshot_version")
  partitionIndex  Int            @default(0) @map("partition_index")
  partitionCount  Int            @default(1) @map("partition_count")
  status          SnapshotStatus @default(queued)
  schemaHash      String?        @map("schema_hash")
  metadata        Json?
  summary         String?
  errorCode       String?        @map("error_code")
  completedAt     DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([connectionId, snapshotVersion, partitionIndex], map: "v2_snapshots_connection_version_partition_key")
  @@index([ownerUserId, connectionId, snapshotVersion(sort: Desc)], map: "v2_snapshots_owner_connection_idx")
  @@map("v2_database_schema_snapshots")
}

/// A durable chat thread bound to one database connection. deletedAt implements
/// user-visible soft deletion; dependent messages and runs remain until cleanup.
model Conversation {
  id             String             @id @db.Uuid
  ownerUserId    String             @map("owner_user_id")
  connectionId   String             @map("connection_id") @db.Uuid
  title          String
  status         ConversationStatus @default(active)
  lastActivityAt DateTime           @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  // SPEC-02 §4: distilled cross-turn analysis memory (entities, filters, window,
  // block summaries, rolling summary). Additive/nullable so historical rows load.
  analysisState  Json?              @map("analysis_state")

  @@unique([id, ownerUserId, connectionId], map: "v2_conversations_id_owner_connection_key")
  @@index([ownerUserId, lastActivityAt(sort: Desc), id(sort: Desc)], map: "v2_conversations_owner_activity_idx")
  @@map("v2_conversations")
}

/// One ordered entry in a conversation. sequence is allocated by appendMessage
/// under a per-conversation transaction lock to preserve deterministic ordering.
model Message {
  id             String      @id @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  sequence       Int
  role           MessageRole
  content        String
  queryRunId     String?     @map("query_run_id") @db.Uuid
  metadata       Json        @default("{\"schemaVersion\":1}")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([conversationId, sequence], map: "v2_messages_conversation_sequence_key")
  @@unique([id, conversationId], map: "v2_messages_id_conversation_key")
  @@index([conversationId, sequence, id], map: "v2_messages_conversation_page_idx")
  @@map("v2_messages")
}

/// Durable execution ledger for one accepted user question. It links the triggering
/// message to status transitions, validation evidence, result metadata, and response.
model QueryRun {
  id                  String         @id @db.Uuid
  ownerUserId         String         @map("owner_user_id")
  conversationId      String         @map("conversation_id") @db.Uuid
  connectionId        String         @map("connection_id") @db.Uuid
  triggeringMessageId String         @map("triggering_message_id") @db.Uuid
  responseMessageId   String?        @map("response_message_id") @db.Uuid
  /// Client-generated retry identity, scoped by owner and conversation below.
  idempotencyKey      String         @map("idempotency_key")
  /// Hash of the logical request; prevents one retry key from changing its payload.
  requestFingerprint  String         @map("request_fingerprint")
  status              QueryRunStatus @default(accepted)
  /// Optimistic-concurrency counter used to reject stale status transitions.
  statusVersion       Int            @default(1) @map("status_version")
  providerId          String         @default("postgresql") @map("provider_id")
  dialectId           String         @default("postgresql") @map("dialect_id")
  generatedQuery      Json?          @map("generated_query")
  validationResult    Json?          @map("validation_result")
  resultPreview       Json?          @map("result_preview")
  resultBlocks        Json           @default("[]") @map("result_blocks")
  returnedRowCount    Int?           @map("returned_row_count")
  totalRowCount       BigInt?        @map("total_row_count")
  truncated           Boolean?
  executionTimeMs     Int?           @map("execution_time_ms")
  generatedAt         DateTime?      @map("generated_at") @db.Timestamptz(6)
  startedAt           DateTime?      @map("started_at") @db.Timestamptz(6)
  finishedAt          DateTime?      @map("finished_at") @db.Timestamptz(6)
  errorCode           String?        @map("error_code")
  errorMessage        String?        @map("error_message")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([id, conversationId], map: "v2_query_runs_id_conversation_key")
  @@unique([ownerUserId, conversationId, idempotencyKey], map: "v2_query_runs_owner_conversation_idempotency_key")
  @@index([ownerUserId, updatedAt(sort: Desc), id(sort: Desc)], map: "v2_query_runs_owner_updated_idx")
  @@index([status, updatedAt], map: "v2_query_runs_recovery_idx")
  @@map("v2_query_runs")
}

model Dashboard {
  id          String    @id @db.Uuid
  ownerUserId String    @map("owner_user_id")
  name        String
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  // SPEC-06 §2 (as-built: whole-dashboard mode): "live" re-executes every widget
  // on load/demand; "snapshot" renders the frozen snapshots forever. New dashboards
  // default live; the migration backfills existing dashboards to "snapshot" so
  // nothing that works today changes behavior.
  mode        String    @default("live")
  // SPEC-06 §5: global date-range filter applied to filter-bound widgets.
  defaultDateRange Json? @map("default_date_range")
  // SPEC-06 §4.2: optional auto-refresh cadence; also overrides the staleness window.
  refreshIntervalSeconds Int? @map("refresh_interval_seconds")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerUserId, updatedAt(sort: Desc), id(sort: Desc)], map: "v2_dashboards_owner_updated_idx")
  @@map("v2_dashboards")
}

model DashboardWidget {
  id              String   @id @db.Uuid
  dashboardId     String   @map("dashboard_id") @db.Uuid
  queryRunId      String?  @map("query_run_id") @db.Uuid
  title           String
  chartConfig     Json     @map("chart_config")
  layout          Json
  snapshot        Json
  queryDefinition Json?    @map("query_definition")
  // SPEC-06 §4.1: denormalized connection so a deleted conversation/run never
  // orphans a widget. Nullable for pre-SPEC-06 widgets (fall back to queryRunId).
  connectionId    String?  @map("connection_id") @db.Uuid
  // SPEC-06 §4.1/§6: refresh bookkeeping surfaced as freshness affordances.
  lastRefreshedAt DateTime? @map("last_refreshed_at") @db.Timestamptz(6)
  lastRefreshError String?  @map("last_refresh_error")
  // SPEC-06 §5: { dateColumn, tableAlias, defaultRange } | null. Present only when
  // the pinned query carries the :qw_from/:qw_to parameter markers.
  filterBinding   Json?    @map("filter_binding")
  // SPEC-09 §2.3: the pinned view's client-side transform (ViewTransform | null).
  // Applied after snapshot/live data load, before charting. Nullable — pre-SPEC-09
  // widgets (and views pinning the raw dataset) simply render the snapshot as-is.
  viewTransform   Json?    @map("view_transform")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([dashboardId, createdAt, id], map: "v2_widgets_dashboard_idx")
  @@map("v2_dashboard_widgets")
}

model DashboardAccessGrant {
  id              String   @id @db.Uuid
  dashboardId     String   @map("dashboard_id") @db.Uuid
  recipientUserId String   @map("recipient_user_id")
  permission      String   @default("view")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([dashboardId, recipientUserId], map: "v2_grants_dashboard_recipient_key")
  @@index([recipientUserId, dashboardId], map: "v2_grants_recipient_dashboard_idx")
  @@map("v2_dashboard_access_grants")
}

model DashboardShareLink {
  id             String    @id @db.Uuid
  dashboardId    String    @map("dashboard_id") @db.Uuid
  tokenHash      String    @unique(map: "v2_share_links_token_hash_key") @map("token_hash")
  encryptedToken Json?     @map("encrypted_token")
  passwordHash   String?   @map("password_hash")
  version        Int       @default(1)
  viewCount      Int       @default(0) @map("view_count")
  lastViewedAt   DateTime? @map("last_viewed_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([dashboardId, createdAt(sort: Desc), id(sort: Desc)], map: "v2_share_links_dashboard_idx")
  @@map("v2_dashboard_share_links")
}

model SharePasswordAttempt {
  id           String   @id @db.Uuid
  keyHash      String   @unique(map: "v2_share_password_attempts_key_hash_key") @map("key_hash")
  attemptCount Int      @default(0) @map("attempt_count")
  resetsAt     DateTime @map("resets_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([resetsAt], map: "v2_share_password_attempts_resets_idx")
  @@map("v2_share_password_attempts")
}

model AuditLog {
  id           String   @id @db.Uuid
  actorUserId  String?  @map("actor_user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  outcome      String
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([actorUserId, createdAt(sort: Desc), id(sort: Desc)], map: "v2_audit_actor_created_idx")
  @@map("v2_audit_logs")
}

model IdempotencyRecord {
  id                 String   @id @db.Uuid
  ownerUserId        String   @map("owner_user_id")
  operation          String   @db.VarChar(100)
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(200)
  requestFingerprint String   @map("request_fingerprint") @db.Char(64)
  response           Json?
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([ownerUserId, operation, idempotencyKey], name: "ownerUserId_operation_idempotencyKey", map: "v2_idempotency_owner_operation_key")
  @@index([expiresAt], map: "v2_idempotency_expiry_idx")
  @@map("v2_idempotency_records")
}

model DurableJob {
  id             String    @id @db.Uuid
  type           String
  payloadVersion Int       @map("payload_version")
  payload        Json
  idempotencyKey String    @map("idempotency_key")
  status         JobStatus @default(queued)
  priority       Int       @default(0)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  lastErrorCode  String?   @map("last_error_code")
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, availableAt, priority(sort: Desc), id], map: "v2_jobs_claim_idx")
  @@index([status, leaseExpiresAt], map: "v2_jobs_lease_idx")
  @@map("v2_durable_jobs")
}

// One row per user (keyed on the Clerk user id, matching every ownerUserId
// column). Lazily upserted on the first authenticated enforcement point. The five
// *Override columns are set by ops: null = use catalog value; a set value wins
// (effectiveLimit = override ?? catalog[planId]).
model UserPlan {
  id           String     @id @db.Uuid
  userId       String     @unique @map("user_id")
  planId       PlanId     @default(free) @map("plan_id")
  status       PlanStatus @default(active)
  source       PlanSource @default(default)
  proGrantedAt DateTime?  @map("pro_granted_at") @db.Timestamptz(6)
  notes        String?

  // Per-user limit overrides. Set by ops; resolved by the entitlement service
  // only. No other product code reads these.
  questionsPerDayOverride       Int? @map("questions_per_day_override")
  questionsPerMonthOverride     Int? @map("questions_per_month_override")
  maxConnectionsOverride        Int? @map("max_connections_override")
  maxDashboardsOverride         Int? @map("max_dashboards_override")
  schemaRefreshesPerDayOverride Int? @map("schema_refreshes_per_day_override")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("v2_user_plans")
}

// SPEC-12: Admin-authored coupon template. A redeemable code that grants users a
// bundle of time-boxed, additive entitlement boosts. Additive to the schema —
// nothing existing changes. Disable (not delete) is the kill switch; existing
// grants keep running to their own expiry because benefits are snapshotted onto
// the redemption row, never read back from the coupon at resolve time.
model Coupon {
  id            String  @id @db.Uuid
  code          String  @unique // canonical (uppercased, trimmed)
  label         String? // admin-facing description, e.g. "Launch week"
  createdByAdmin String @map("created_by_admin") // admin Clerk id

  // Benefit bundle (all optional; a coupon must carry at least one — validated at create).
  questionsPerDayDelta   Int     @default(0) @map("questions_per_day_delta")
  questionsPerMonthDelta Int     @default(0) @map("questions_per_month_delta")
  maxConnectionsDelta    Int     @default(0) @map("max_connections_delta")
  maxDashboardsDelta     Int     @default(0) @map("max_dashboards_delta")
  grantsPro              Boolean @default(false) @map("grants_pro")

  // How long the benefit lasts for a user, from the moment they redeem.
  grantDurationDays Int @map("grant_duration_days") // required, 1..3650

  // Redemption window (independent optional constraints; both null = unlimited).
  redeemableUntil DateTime? @map("redeemable_until") @db.Timestamptz(6)
  maxRedemptions  Int?      @map("max_redemptions") // null = unlimited count
  redemptionCount Int       @default(0) @map("redemption_count") // denormalized for atomic cap checks

  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(6) // admin kill switch

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  redemptions CouponRedemption[]

  @@index([disabledAt, redeemableUntil], map: "v2_coupons_active_idx")
  @@map("v2_coupons")
}

// SPEC-12: One row per (user, coupon) redemption — the grant ledger. Snapshots
// the benefits at redemption time so later coupon edits/disables never mutate a
// live grant. The resolver reads these rows (grantExpiresAt > now()), never the
// coupon, for live entitlement math.
model CouponRedemption {
  id             String   @id @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  userId         String   @map("user_id") // Clerk id, same convention as UserPlan
  redeemedAt     DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)
  grantExpiresAt DateTime @map("grant_expires_at") @db.Timestamptz(6) // redeemedAt + grantDurationDays

  // Snapshot of the benefits at redemption time (source of truth for the resolver).
  questionsPerDayDelta   Int     @default(0) @map("questions_per_day_delta")
  questionsPerMonthDelta Int     @default(0) @map("questions_per_month_delta")
  maxConnectionsDelta    Int     @default(0) @map("max_connections_delta")
  maxDashboardsDelta     Int     @default(0) @map("max_dashboards_delta")
  grantsPro              Boolean @default(false) @map("grants_pro")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId], map: "v2_coupon_redemptions_coupon_user_key") // one per user per coupon
  @@index([userId, grantExpiresAt], map: "v2_coupon_redemptions_user_active_idx") // resolver hot path
  @@map("v2_coupon_redemptions")
}

// Per-user rolling counters for fast quota checks. One row per (user, periodType,
// periodKey). Incremented atomically alongside question accept.
model UserUsagePeriod {
  id                   String   @id @db.Uuid
  userId               String   @map("user_id")
  periodType           String   @map("period_type") // "day" | "month"
  periodKey            String   @map("period_key") // "2026-07-09" | "2026-07"
  questionsAccepted    Int      @default(0) @map("questions_accepted")
  questionsSucceeded   Int      @default(0) @map("questions_succeeded")
  questionsFailed      Int      @default(0) @map("questions_failed")
  schemaRefreshes      Int      @default(0) @map("schema_refreshes")
  chartsGenerated      Int      @default(0) @map("charts_generated")
  llmInputTokens       BigInt   @default(0) @map("llm_input_tokens")
  llmOutputTokens      BigInt   @default(0) @map("llm_output_tokens")
  llmCachedInputTokens BigInt   @default(0) @map("llm_cached_input_tokens")
  llmCallCount         Int      @default(0) @map("llm_call_count")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, periodType, periodKey], map: "v2_user_usage_periods_user_period_key")
  @@index([periodType, periodKey], map: "v2_user_usage_periods_period_idx")
  @@map("v2_user_usage_periods")
}

// Lifetime rollups. Current resource counts (dashboards/connections now) are
// derived from primary tables, not these lifetime counters.
model UserUsageTotals {
  userId               String   @id @map("user_id")
  questionsAccepted    Int      @default(0) @map("questions_accepted")
  questionsSucceeded   Int      @default(0) @map("questions_succeeded")
  questionsFailed      Int      @default(0) @map("questions_failed")
  chartsGenerated      Int      @default(0) @map("charts_generated")
  dashboardsCreated    Int      @default(0) @map("dashboards_created")
  connectionsCreated   Int      @default(0) @map("connections_created")
  sharesCreated        Int      @default(0) @map("shares_created")
  schemaSyncsSucceeded Int      @default(0) @map("schema_syncs_succeeded")
  llmInputTokens       BigInt   @default(0) @map("llm_input_tokens")
  llmOutputTokens      BigInt   @default(0) @map("llm_output_tokens")
  llmCachedInputTokens BigInt   @default(0) @map("llm_cached_input_tokens")
  llmCallCount         Int      @default(0) @map("llm_call_count")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("v2_user_usage_totals")
}

// One row per model call (agent, utility, title, memory, verify, ingest,
// embedding, ...). Idempotency via (queryRunId, callOrdinal). The task and
// provider/model indexes back the ops cost-explorer queries.
model LlmUsageRecord {
  id                String   @id @db.Uuid
  userId            String   @map("user_id")
  queryRunId        String?  @map("query_run_id") @db.Uuid
  connectionId      String?  @map("connection_id") @db.Uuid
  task              String
  provider          String
  model             String
  inputTokens       Int      @default(0) @map("input_tokens")
  outputTokens      Int      @default(0) @map("output_tokens")
  totalTokens       Int      @default(0) @map("total_tokens")
  cachedInputTokens Int      @default(0) @map("cached_input_tokens")
  reasoningTokens   Int?     @map("reasoning_tokens")
  success           Boolean  @default(true)
  latencyMs         Int?     @map("latency_ms")
  attemptIndex      Int?     @map("attempt_index")
  callOrdinal       Int?     @map("call_ordinal")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "v2_llm_usage_user_created_idx")
  @@index([queryRunId], map: "v2_llm_usage_query_run_idx")
  @@index([task, createdAt(sort: Desc)], map: "v2_llm_usage_task_created_idx")
  @@index([provider, model, createdAt(sort: Desc)], map: "v2_llm_usage_provider_model_idx")
  @@map("v2_llm_usage_records")
}

// Per-question aggregate ("what did this question cost?").
model QueryRunUsage {
  queryRunId        String   @id @map("query_run_id") @db.Uuid
  userId            String   @map("user_id")
  inputTokens       Int      @default(0) @map("input_tokens")
  outputTokens      Int      @default(0) @map("output_tokens")
  cachedInputTokens Int      @default(0) @map("cached_input_tokens")
  llmCallCount      Int      @default(0) @map("llm_call_count")
  agentSteps        Int?     @map("agent_steps")
  sqlAttempts       Int?     @map("sql_attempts")
  budgetProfile     String?  @map("budget_profile")
  chartGenerated    Boolean  @default(false) @map("chart_generated")
  chartType         String?  @map("chart_type")
  primaryProvider   String?  @map("primary_provider")
  primaryModel      String?  @map("primary_model")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "v2_query_run_usage_user_idx")
  @@map("v2_query_run_usage")
}

// Append-only product analytics. payload holds small safe JSON only (counts,
// enums, ids, booleans); never secrets or row data.
model MetricEvent {
  id           String   @id @db.Uuid
  userId       String?  @map("user_id")
  eventType    String   @map("event_type")
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  queryRunId   String?  @map("query_run_id") @db.Uuid
  payload      Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "v2_metric_events_user_created_idx")
  @@index([eventType, createdAt(sort: Desc)], map: "v2_metric_events_type_created_idx")
  @@map("v2_metric_events")
}

// Audit of plan mutations (manual grant/revoke; future payment webhooks).
model PlanChangeLog {
  id         String   @id @db.Uuid
  userId     String   @map("user_id")
  fromPlanId String   @map("from_plan_id")
  toPlanId   String   @map("to_plan_id")
  source     String
  notes      String?
  actorLabel String?  @map("actor_label")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "v2_plan_change_log_user_idx")
  @@map("v2_plan_change_logs")
}
